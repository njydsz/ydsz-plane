# ============================================================
# 代码签名与公证配置（复制为 .signing.env 并填写真实值）
# ============================================================
# 注意：.signing.env 应加入 .gitignore，切勿提交真实凭证
# ============================================================

# ------------------------------------------------------------
# macOS 签名（Apple Developer ID Application 证书）
# ------------------------------------------------------------
# 证书名称（Keychain 中显示的名称）
MACOS_SIGN_IDENTITY="Developer ID Application: Your Name (TEAM_ID)"
# 团队 ID（Apple Developer 页面）
MACOS_TEAM_ID="YOUR_TEAM_ID"
# 是否启用签名（true/false）
MACOS_SIGN_ENABLED=false

# ------------------------------------------------------------
# macOS 公证（notarytool）
# ------------------------------------------------------------
# Apple ID（用于公证）
MACOS_NOTARY_APPLE_ID="your@example.com"
# 专用密码（在 appleid.apple.com 生成）
MACOS_NOTARY_PASSWORD="@keychain:AC_PASSWORD"
# 团队 ID（与签名一致）
MACOS_NOTARY_TEAM_ID="YOUR_TEAM_ID"
# 是否启用公证
MACOS_NOTARY_ENABLED=false

# ------------------------------------------------------------
# Windows 签名（Authenticode）
# ------------------------------------------------------------
# 证书文件路径（.pfx）
WINDOWS_SIGN_CERT="build/certs/ydsz-plane.pfx"
# 证书密码
WINDOWS_SIGN_PASSWORD=""
# 时间戳服务器（推荐 DigiCert）
WINDOWS_SIGN_TIMESTAMP="http://timestamp.digicert.com"
# 是否启用签名
WINDOWS_SIGN_ENABLED=false

# ------------------------------------------------------------
# Windows 交叉签名（Linux/macOS 上构建 Windows 时）
# ------------------------------------------------------------
# osslsigncode 证书（PEM 格式）
WINDOWS_OSSL_CERT="build/certs/ydsz-plane.pem"
WINDOWS_OSSL_KEY="build/certs/ydsz-plane.key"
# osslsigncode 是否可用
WINDOWS_OSSL_ENABLED=false

# ------------------------------------------------------------
# 通用
# ------------------------------------------------------------
# 构建版本（覆盖 wails.json 的 productVersion）
APP_VERSION="0.1.0"

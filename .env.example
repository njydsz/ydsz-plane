# 复制为 .env 并修改。生产环境必须修改所有 CHANGE_ME。
YDSZ_SERVER_ENV=development
YDSZ_SERVER_PORT=8080

YDSZ_DATABASE_URL=postgres://ydsz:ydsz@localhost:5432/ydsz?sslmode=disable
YDSZ_REDIS_ADDR=localhost:6379
YDSZ_NATS_URL=nats://localhost:4222

# 生产必填：强随机值（openssl rand -hex 32）
YDSZ_AUTH_JWT_SECRET=CHANGE_ME

YDSZ_LOG_LEVEL=info
YDSZ_LOG_FORMAT=console

YDSZ_FEATURES_REGISTRATION_OPEN=true
YDSZ_FEATURES_SEARCH_ENABLED=false
YDSZ_FEATURES_AUTOMATION_ENABLED=false
YDSZ_FEATURES_WEBHOOKS_ENABLED=false

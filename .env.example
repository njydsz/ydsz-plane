# 复制为 .env 并修改。
# 以下为本地开发环境配置，基于 docx 文档中的真实环境信息。
# 生产环境必须修改所有 CHANGE_ME 或默认密码。

YDSZ_SERVER_ENV=development
YDSZ_SERVER_PORT=8080

# PostgreSQL 本地开发配置
# 地址: 127.0.0.1:5432, 账号: postgres, 密码: Limw1020, 数据库: ydsz-plane
YDSZ_DATABASE_URL=postgres://postgres:Limw1020@127.0.0.1:5432/ydsz-plane?sslmode=disable

# Redis 本地开发配置
# 地址: 127.0.0.1:6379, 密码: Limw1020
# 用途：缓存、分布式锁、限流、会话辅助、WebSocket 扇出
# 注意：已移除 Redis 作为消息/任务队列中间件的职责，纯 API 层使用
YDSZ_REDIS_ADDR=127.0.0.1:6379
YDSZ_REDIS_PASSWORD=Limw1020

# RabbitMQ 本地开发配置
# 地址: 127.0.0.1:5672, 账号: guest, 密码: guest
# 用途（Worker 进程独占）：
#   - 事件总线：Outbox → plane.events topic exchange → consumer queues
#   - 任务队列：TaskExchange 分发异步任务（延迟/优先级/死信/Retry-with-backoff）
# Management UI: http://127.0.0.1:15672
YDSZ_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# 双中间件分工说明：
# - Redis 8:    缓存、限流、分布式锁、WebSocket 扇出（Worker 不连接 Redis）
# - RabbitMQ 4: 事件总线 + 任务队列（API + Worker 共用 Exchange，Worker 独占 Queue）

# 生产必填：强随机值（openssl rand -hex 32）
YDSZ_AUTH_JWT_SECRET=CHANGE_ME

YDSZ_LOG_LEVEL=debug
YDSZ_LOG_FORMAT=console

YDSZ_FEATURES_REGISTRATION_OPEN=true
YDSZ_FEATURES_SEARCH_ENABLED=false
YDSZ_FEATURES_AUTOMATION_ENABLED=false
YDSZ_FEATURES_WEBHOOKS_ENABLED=false

# 邮件配置（本地开发使用 Mailpit）
YDSZ_EMAIL_ENABLED=false
YDSZ_EMAIL_SMTP_HOST=127.0.0.1
YDSZ_EMAIL_SMTP_PORT=1025
YDSZ_EMAIL_FROM="Ydsz Plane <no-reply@ydsz.dev>"
YDSZ_EMAIL_APP_BASE_URL=http://localhost:5173

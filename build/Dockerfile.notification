# Ydsz Plane · 通知服务独立容器（S14 Phase-1）
#
# 构建：docker build -f build/Dockerfile.notification -t ydsz-plane-notification:latest .
# 运行：docker run -e DATABASE_URL=... -e RABBITMQ_URL=... ydsz-plane-notification:latest

FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata gcc musl-dev

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w -extldflags=-static" \
    -o /out/notification-service \
    ./cmd/notification-service

# -----------------------------------------------------------
FROM alpine:3.21

RUN apk add --no-cache ca-certificates curl tzdata && \
    addgroup -S app && adduser -S app -G app

COPY --from=builder /out/notification-service /usr/local/bin/notification-service

USER app
EXPOSE 9090 8080

HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD curl -sf http://localhost:8080/healthz || exit 1

ENTRYPOINT ["notification-service"]

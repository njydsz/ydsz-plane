{
  "name": "ydsz-plane-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-draggable-plus": "^0.6.1",
    "vue-echarts": "^8.1.0",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.29.0",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.1.6"
  }
}
